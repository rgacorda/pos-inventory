# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pc_parts_db?schema=public"

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Application
PORT=3000
NODE_ENV=development
# IANA timezone used for report hour/date grouping (e.g. hourly sales).
# Order timestamps are stored naive in the Node process timezone; reports
# convert from that zone into APP_TIMEZONE. Defaults to Asia/Manila.
APP_TIMEZONE=Asia/Manila
